# Server Port (must be 3000 in AI Studio preview)
PORT=3000

# JWT Secret for Admin Authentication (change in production!)
JWT_SECRET="change-this-to-a-strong-random-64-char-secret-in-production"

# Default Admin Credentials created on first run (Owner is forced to change on first login)
ADMIN_DEFAULT_PASSWORD="BuildBody@2026"
ADMIN_STAFF_PASSWORD="Staff@2026"

# Application URL (used for SEO canonical URLs and links)
APP_URL="http://localhost:3000"

# Optional: Set when hosting frontend on Netlify and backend separately (e.g. Cloud Run / Render)
# Leave blank to use same-origin /api/* (local server or Netlify Functions)
VITE_API_BASE_URL=""

# Optional: Allowed CORS origin when frontend & backend are on different domains
# CORS_ORIGIN="https://your-site.netlify.app"

# Optional: Custom directory path for SQLite database and uploads
# DATA_DIR="./data"
